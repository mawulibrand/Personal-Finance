generator client {
  provider = "prisma-client"
  output = "../generated"
}
datasource db {
  provider = "postgresql"
}
enum SpaceType {
  PERSONAL
  HOUSEHOLD
}
enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}
enum TokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
}
enum CategoryType {
  INCOME
  EXPENSE
}
enum IncomeSourceType {
  SALARY
  SELF_EMPLOYMENT
  BUSINESS
  INVESTMENT
  GIFT
  OTHER
}
enum PaydayAdjustmentRule {
  PREVIOUS_WORKING_DAY
  NEXT_WORKING_DAY
  NO_ADJUSTMENT
}
enum RecurringFlow {
  INCOME
  EXPENSE
}
enum RecurrenceFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  YEARLY
}
enum SavingsTransactionType {
  DEPOSIT
  WITHDRAWAL
}
enum LiabilityType {
  CREDIT_CARD
  PERSONAL_LOAN
  MORTGAGE
  STUDENT_LOAN
  AUTO_LOAN
  BUY_NOW_PAY_LATER
  OTHER
}
enum LiabilityStatus {
  ACTIVE
  PAID_OFF
}
enum GoalContributionType {
  CONTRIBUTION
  WITHDRAWAL
}
enum PaydayActionType {
  SAVINGS_DEPOSIT
  GOAL_CONTRIBUTION
  LIABILITY_PAYMENT
}
enum PaydayActionStatus {
  DUE
  PARTIALLY_COMPLETED
  COMPLETED
  SKIPPED
}
enum InvestmentType {
  STOCK
  BOND
  TREASURY_BILL
  MUTUAL_FUND
  ETF
  FIXED_INCOME
  REAL_ESTATE
  BUSINESS_INVESTMENT
  CRYPTOCURRENCY
  FIXED_DEPOSIT
  OTHER
}
enum InvestmentTransactionType {
  BUY
  CONTRIBUTION
  SELL
  WITHDRAWAL
  DIVIDEND
  INTEREST
  FEE
  TAX
}
enum InvestmentValuationMethod {
  MANUAL
  QUANTITY_X_PRICE
  CONTRACTUAL
}
enum FixedDepositInterestMethod {
  SIMPLE
  COMPOUND
}
enum InvestmentStatus {
  ACTIVE
  CLOSED
}
enum ScenarioContributionFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
  YEARLY
}
enum FinancialRuleOperator {
  LESS_THAN
  GREATER_THAN
}
enum FinancialRuleSeverity {
  HIGH
  MEDIUM
  LOW
}
enum FinancialReviewTrigger {
  MONTHLY
  ON_DEMAND
}
enum StrategyDecision {
  PROPOSED
  SELECTED
  MODIFIED
  REJECTED
}
enum RecommendationFeedback {
  HELPFUL
  NOT_HELPFUL
  NOT_APPLICABLE
}
model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  name String
  passwordHash String
  emailVerifiedAt DateTime? @db.Timestamptz
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  memberships Membership[]
  sessions Session[]
  tokens AuthToken[]
  expenseRecords ExpenseRecord[]
  budgets Budget[]
  recurringRecords RecurringRecord[]
  savingsAccounts SavingsAccount[]
  savingsTransactions SavingsTransaction[]
  liabilities Liability[]
  liabilityPayments LiabilityPayment[]
  goals FinancialGoal[]
  netWorthSnapshots NetWorthSnapshot[]
  goalContributions GoalContribution[]
  paydayRoutineActions PaydayRoutineAction[]
  investmentAccounts InvestmentAccount[]
  investments Investment[]
  investmentTransactions InvestmentTransaction[]
  investmentValuations InvestmentValuation[]
  scenarios Scenario[]
  financialPlans FinancialPlan[]
  financialReviews FinancialProfileSnapshot[]
  strategyResponses RecommendationStrategy[]
  personalSpace FinancialSpace? @relation("PersonalOwner")
}
model FinancialSpace {
  id String @id @default(uuid()) @db.Uuid
  name String
  type SpaceType
  baseCurrency String @default("GHS") @db.Char(3)
  personalOwnerId String? @unique @db.Uuid
  personalOwner User? @relation("PersonalOwner", fields: [personalOwnerId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  memberships Membership[]
  categories Category[]
  incomeSources IncomeSource[]
  expenseRecords ExpenseRecord[]
  budgets Budget[]
  recurringRecords RecurringRecord[]
  savingsAccounts SavingsAccount[]
  liabilities Liability[]
  goals FinancialGoal[]
  netWorthSnapshots NetWorthSnapshot[]
  paydayRoutineActions PaydayRoutineAction[]
  investmentAccounts InvestmentAccount[]
  scenarios Scenario[]
  financialPlans FinancialPlan[]
  financialReviews FinancialProfileSnapshot[]
}
model Membership {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  spaceId String @db.Uuid
  role Role
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  space FinancialSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  @@unique([userId, spaceId])
}
model Session {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  tokenHash String @unique
  expiresAt DateTime @db.Timestamptz
  createdAt DateTime @default(now()) @db.Timestamptz
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
model AuthToken {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  tokenHash String @unique
  purpose TokenPurpose
  expiresAt DateTime @db.Timestamptz
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, purpose])
}
model AuditEvent {
  id String @id @default(uuid()) @db.Uuid
  actorUserId String? @db.Uuid
  spaceId String? @db.Uuid
  action String
  createdAt DateTime @default(now()) @db.Timestamptz
  @@index([actorUserId, createdAt])
}
model EmailOutbox {
  id String @id @default(uuid()) @db.Uuid
  recipient String
  subject String
  body String
  createdAt DateTime @default(now()) @db.Timestamptz
  sentAt DateTime? @db.Timestamptz
  @@index([sentAt, createdAt])
}
model Category {
  id String @id @default(uuid()) @db.Uuid
  spaceId String @db.Uuid
  name String
  normalizedName String
  type CategoryType
  isSystem Boolean @default(false)
  isArchived Boolean @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  space FinancialSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  expenseRecords ExpenseRecord[]
  budgetAllocations BudgetAllocation[]
  recurringRecords RecurringRecord[]
  @@unique([spaceId, type, normalizedName])
  @@index([spaceId, type, isArchived])
}
model IncomeSource {
  id String @id @default(uuid()) @db.Uuid
  spaceId String @db.Uuid
  name String
  type IncomeSourceType
  expectedAmount Decimal? @db.Decimal(19, 4)
  currencyCode String @default("GHS") @db.Char(3)
  isActive Boolean @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  space FinancialSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  expectedPaydays SalaryExpectedDate[]
  records IncomeRecord[]
  paydayRoutineActions PaydayRoutineAction[]
  recurringRecords RecurringRecord[]
  @@index([spaceId, isActive, createdAt])
}
model SalaryExpectedDate {
  id String @id @default(uuid()) @db.Uuid
  sourceId String @db.Uuid
  sequence Int
  dayOfMonth Int
  adjustmentRule PaydayAdjustmentRule
  source IncomeSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  @@unique([sourceId, sequence])
  @@index([sourceId, dayOfMonth])
}
model IncomeRecord {
  id String @id @default(uuid()) @db.Uuid
  sourceId String @db.Uuid
  amount Decimal @db.Decimal(19, 4)
  receivedDate DateTime @db.Date
  periodYear Int?
  periodMonth Int?
  recurringOccurrenceId String? @unique @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz
  source IncomeSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  recurringOccurrence RecurringOccurrence? @relation("RecurringIncome", fields: [recurringOccurrenceId], references: [id], onDelete: SetNull)
  paydayRoutineEntries PaydayRoutineEntry[]
  @@unique([sourceId, periodYear, periodMonth])
  @@index([sourceId, receivedDate])
}
model ExpenseRecord {
  id String @id @default(uuid()) @db.Uuid
  spaceId String @db.Uuid
  categoryId String @db.Uuid
  amount Decimal @db.Decimal(19, 4)
  currencyCode String @db.Char(3)
  spentAt DateTime @db.Date
  description String?
  createdBy String @db.Uuid
  recurringOccurrenceId String? @unique @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  space FinancialSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  recurringOccurrence RecurringOccurrence? @relation("RecurringExpense", fields: [recurringOccurrenceId], references: [id], onDelete: SetNull)
  @@index([spaceId, spentAt])
  @@index([categoryId, spentAt])
}
model RecurringRecord {
  id String @id @default(uuid()) @db.Uuid
  spaceId String @db.Uuid
  name String
  flow RecurringFlow
  amount Decimal @db.Decimal(19, 4)
  currencyCode String @db.Char(3)
  frequency RecurrenceFrequency
  startDate DateTime @db.Date
  nextDueDate DateTime @db.Date
  endDate DateTime? @db.Date
  dayOfMonth Int
  monthOfYear Int?
  categoryId String? @db.Uuid
  sourceId String? @db.Uuid
  isActive Boolean @default(true)
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  space FinancialSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  source IncomeSource? @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  occurrences RecurringOccurrence[]
  @@index([spaceId, isActive, nextDueDate])
}
model RecurringOccurrence {
  id String @id @default(uuid()) @db.Uuid
  recurringRecordId String @db.Uuid
  dueDate DateTime @db.Date
  actualDate DateTime @db.Date
  createdAt DateTime @default(now()) @db.Timestamptz
  recurringRecord RecurringRecord @relation(fields: [recurringRecordId], references: [id], onDelete: Cascade)
  incomeRecord IncomeRecord? @relation("RecurringIncome")
  expenseRecord ExpenseRecord? @relation("RecurringExpense")
  @@unique([recurringRecordId, dueDate])
  @@index([actualDate])
}
model Budget {
  id String @id @default(uuid()) @db.Uuid
  spaceId String @db.Uuid
  year Int
  month Int
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  space FinancialSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  allocations BudgetAllocation[]
  @@unique([spaceId, year, month])
  @@index([spaceId, year, month])
}
model BudgetAllocation {
  id String @id @default(uuid()) @db.Uuid
  budgetId String @db.Uuid
  categoryId String @db.Uuid
  limitAmount Decimal @db.Decimal(19, 4)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  @@unique([budgetId, categoryId])
  @@index([categoryId])
}
model SavingsAccount {
  id String @id @default(uuid()) @db.Uuid
  spaceId String @db.Uuid
  name String
  provider String?
  currencyCode String @default("GHS") @db.Char(3)
  openingBalance Decimal @default(0) @db.Decimal(19, 4)
  openedAt DateTime @db.Date
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  space FinancialSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  transactions SavingsTransaction[]
  paydayRoutineActions PaydayRoutineAction[]
  @@index([spaceId, createdAt])
}
model SavingsTransaction {
  id String @id @default(uuid()) @db.Uuid
  accountId String @db.Uuid
  type SavingsTransactionType
  amount Decimal @db.Decimal(19, 4)
  transactionDate DateTime @db.Date
  description String?
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz
  account SavingsAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  @@index([accountId, transactionDate, createdAt])
}
model Liability {
  id String @id @default(uuid()) @db.Uuid
  spaceId String @db.Uuid
  type LiabilityType
  name String
  provider String?
  currencyCode String @default("GHS") @db.Char(3)
  originalAmount Decimal @db.Decimal(19, 4)
  openingBalance Decimal @db.Decimal(19, 4)
  annualInterestRate Decimal @default(0) @db.Decimal(7, 4)
  monthlyPayment Decimal? @db.Decimal(19, 4)
  startDate DateTime @db.Date
  expectedPayoffDate DateTime? @db.Date
  status LiabilityStatus @default(ACTIVE)
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  space FinancialSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  payments LiabilityPayment[]
  paydayRoutineActions PaydayRoutineAction[]
  @@index([spaceId, status, createdAt])
}
model LiabilityPayment {
  id String @id @default(uuid()) @db.Uuid
  liabilityId String @db.Uuid
  amount Decimal @db.Decimal(19, 4)
  principalAmount Decimal @db.Decimal(19, 4)
  paidAt DateTime @db.Date
  description String?
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz
  liability Liability @relation(fields: [liabilityId], references: [id], onDelete: Cascade)
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  @@index([liabilityId, paidAt, createdAt])
}
model FinancialGoal {
  id String @id @default(uuid()) @db.Uuid
  spaceId String @db.Uuid
  name String
  description String?
  currencyCode String @default("GHS") @db.Char(3)
  targetAmount Decimal @db.Decimal(19, 4)
  targetDate DateTime? @db.Date
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  space FinancialSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  contributions GoalContribution[]
  paydayRoutineActions PaydayRoutineAction[]
  financialPlan FinancialPlan?
  @@index([spaceId, createdAt])
}
model GoalContribution {
  id String @id @default(uuid()) @db.Uuid
  goalId String @db.Uuid
  type GoalContributionType
  amount Decimal @db.Decimal(19, 4)
  contributionDate DateTime @db.Date
  description String?
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz
  goal FinancialGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  @@index([goalId, contributionDate, createdAt])
}
model Scenario {
  id String @id @default(uuid()) @db.Uuid
  spaceId String @db.Uuid
  name String
  currencyCode String @db.Char(3)
  startingCapital Decimal @db.Decimal(19, 4)
  recurringContribution Decimal @db.Decimal(19, 4)
  contributionFrequency ScenarioContributionFrequency
  expectedAnnualReturn Decimal @db.Decimal(7, 4)
  durationYears Int
  inflationRate Decimal @default(0) @db.Decimal(7, 4)
  annualContributionGrowth Decimal @default(0) @db.Decimal(7, 4)
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  space FinancialSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  financialPlan FinancialPlan?
  @@index([spaceId, createdAt])
}
model FinancialPlan {
  id String @id @default(uuid()) @db.Uuid
  spaceId String @db.Uuid
  scenarioId String @unique @db.Uuid
  goalId String @unique @db.Uuid
  recommendationStrategyId String? @unique @db.Uuid
  name String
  currencyCode String @db.Char(3)
  startingCapital Decimal @db.Decimal(19, 4)
  recurringContribution Decimal @db.Decimal(19, 4)
  contributionFrequency ScenarioContributionFrequency
  expectedAnnualReturn Decimal @db.Decimal(7, 4)
  durationYears Int
  inflationRate Decimal @db.Decimal(7, 4)
  annualContributionGrowth Decimal @db.Decimal(7, 4)
  projectedTarget Decimal @db.Decimal(19, 4)
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  space FinancialSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  scenario Scenario @relation(fields: [scenarioId], references: [id], onDelete: Restrict)
  goal FinancialGoal @relation(fields: [goalId], references: [id], onDelete: Restrict)
  recommendationStrategy RecommendationStrategy? @relation(fields: [recommendationStrategyId], references: [id], onDelete: SetNull)
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  @@index([spaceId, createdAt])
}
model FinancialRule {
  id String @id @default(uuid()) @db.Uuid
  code String
  market String @default("*") @db.VarChar(3)
  metric String
  operator FinancialRuleOperator
  threshold Decimal @db.Decimal(19, 4)
  severity FinancialRuleSeverity
  enabled Boolean @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  @@unique([code, market])
  @@index([market, enabled])
}
model FinancialProfileSnapshot {
  id String @id @default(uuid()) @db.Uuid
  spaceId String @db.Uuid
  createdBy String @db.Uuid
  trigger FinancialReviewTrigger
  monthlyPeriod String?
  currencyCode String @db.Char(3)
  periodStart DateTime @db.Date
  periodEnd DateTime @db.Date
  profile Json
  createdAt DateTime @default(now()) @db.Timestamptz
  space FinancialSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  strategies RecommendationStrategy[]
  @@unique([spaceId, monthlyPeriod])
  @@index([spaceId, createdAt])
}
model RecommendationStrategy {
  id String @id @default(uuid()) @db.Uuid
  snapshotId String @db.Uuid
  ruleCode String
  severity FinancialRuleSeverity
  title String
  explanation String
  observedValue Decimal @db.Decimal(19, 4)
  threshold Decimal @db.Decimal(19, 4)
  decision StrategyDecision @default(PROPOSED)
  feedback RecommendationFeedback?
  userNote String?
  respondedBy String? @db.Uuid
  respondedAt DateTime? @db.Timestamptz
  createdAt DateTime @default(now()) @db.Timestamptz
  snapshot FinancialProfileSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  responder User? @relation(fields: [respondedBy], references: [id], onDelete: Restrict)
  financialPlan FinancialPlan?
  @@unique([snapshotId, ruleCode])
  @@index([snapshotId, severity])
}
model NetWorthSnapshot {
  id String @id @default(uuid()) @db.Uuid
  spaceId String @db.Uuid
  snapshotDate DateTime @db.Date
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz
  space FinancialSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  currencies NetWorthSnapshotCurrency[]
  @@unique([spaceId, snapshotDate])
  @@index([spaceId, snapshotDate])
}
model NetWorthSnapshotCurrency {
  id String @id @default(uuid()) @db.Uuid
  snapshotId String @db.Uuid
  currencyCode String @db.Char(3)
  assets Decimal @db.Decimal(19, 4)
  liabilities Decimal @db.Decimal(19, 4)
  netWorth Decimal @db.Decimal(19, 4)
  snapshot NetWorthSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  @@unique([snapshotId, currencyCode])
  @@index([currencyCode])
}
model PaydayRoutineAction {
  id String @id @default(uuid()) @db.Uuid
  spaceId String @db.Uuid
  sourceId String @db.Uuid
  type PaydayActionType
  name String
  plannedAmount Decimal @db.Decimal(19, 4)
  savingsAccountId String? @db.Uuid
  goalId String? @db.Uuid
  liabilityId String? @db.Uuid
  isActive Boolean @default(true)
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  space FinancialSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  source IncomeSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  savingsAccount SavingsAccount? @relation(fields: [savingsAccountId], references: [id], onDelete: Restrict)
  goal FinancialGoal? @relation(fields: [goalId], references: [id], onDelete: Restrict)
  liability Liability? @relation(fields: [liabilityId], references: [id], onDelete: Restrict)
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  entries PaydayRoutineEntry[]
  @@index([spaceId, isActive, createdAt])
}
model PaydayRoutineEntry {
  id String @id @default(uuid()) @db.Uuid
  incomeRecordId String @db.Uuid
  actionId String @db.Uuid
  plannedAmount Decimal @db.Decimal(19, 4)
  completedAmount Decimal @default(0) @db.Decimal(19, 4)
  status PaydayActionStatus @default(DUE)
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  incomeRecord IncomeRecord @relation(fields: [incomeRecordId], references: [id], onDelete: Cascade)
  action PaydayRoutineAction @relation(fields: [actionId], references: [id], onDelete: Restrict)
  @@unique([incomeRecordId, actionId])
  @@index([status, createdAt])
}
model InvestmentAccount {
  id String @id @default(uuid()) @db.Uuid
  spaceId String @db.Uuid
  name String
  provider String?
  currencyCode String @default("GHS") @db.Char(3)
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  space FinancialSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  investments Investment[]
  @@index([spaceId, createdAt])
}
model Investment {
  id String @id @default(uuid()) @db.Uuid
  accountId String @db.Uuid
  type InvestmentType
  name String
  currencyCode String @db.Char(3)
  costBasis Decimal @default(0) @db.Decimal(19, 4)
  startDate DateTime @db.Date
  maturityDate DateTime? @db.Date
  annualInterestRate Decimal? @db.Decimal(7, 4)
  interestMethod FixedDepositInterestMethod?
  compoundingFrequency Int?
  expectedMaturityValue Decimal? @db.Decimal(19, 4)
  actualMaturityValue Decimal? @db.Decimal(19, 4)
  status InvestmentStatus @default(ACTIVE)
  closedAt DateTime? @db.Date
  createdBy String @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  account InvestmentAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  creator User @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  transactions InvestmentTransaction[]
  valuations InvestmentValuation[]
  @@index([accountId, status, startDate])
  @@index([type, maturityDate])
}
model InvestmentTransaction {
  id String @id @default(uuid()) @db.Uuid
  investmentId String @db.Uuid
  type InvestmentTransactionType
  amount Decimal @db.Decimal(19, 4)
  quantity Decimal? @db.Decimal(24, 8)
  transactionDate DateTime @db.Date
  description String?
